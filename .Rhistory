library(readxl)
library(ggplot2)
library(patchwork)
basedir <- "C:/Users/szapa/Documents/Maestria_IPN/Cuarto_semestre/Estancia/INIA/texel/servidor/comparaciones"
setwd(basedir)
# Archivos y títulos
archivos <- c(
"ebv_gebv_rasgo1.xlsx",
"ebv_gebv_rasgo2.xlsx",
"ebv_gebv_rasgo3.xlsx",
"ebv_gebv_rasgo4.xlsx",
"ebv_gebv_rasgo5.xlsx",
"ebv_gebv_rasgo6.xlsx"
)
titulos <- c(
"Peso al nacimiento",
"Peso al destete",
"Peso de recría",
"Área ojo de bife",
"Espesor de grasa",
"Peso de canal caliente"
)
# Lista vacía para guardar gráficos
graficos <- list()
# Loop para crear cada gráfico
for(i in 1:6){
df <- read_excel(archivos[i])
p <- ggplot(df,
aes(x = acc_ebv,
y = acc_gebv,
color = genotipados)) +
geom_point(size = 2.5,
alpha = 0.9) +
geom_abline(slope = 1,
intercept = 0,
color = "red",
linewidth = 0.8) +
scale_color_manual(values = c(
"SI" = "#3C5488",
"NO" = "#00A087"
)) +
theme_classic(base_size = 12) +
labs(
title = titulos[i],
x = "EBV accuracy",
y = "GEBV accuracy",
color = "Genotipado"
) +
theme(
plot.title = element_text(face = "bold", hjust = 0.5),
legend.position = "bottom"
)
graficos[[i]] <- p
}
# Combinar en formato 3x2
figura_final <-
(graficos[[1]] | graficos[[2]]) /
(graficos[[3]] | graficos[[4]]) /
(graficos[[5]] | graficos[[6]])
# Mostrar
figura_final
# Exportar en alta calidad
ggsave(
"Figura_completa_accuracies.png",
figura_final,
width = 14,
height = 16,
dpi = 600
)
library(readxl)
library(ggplot2)
library(dplyr)
basedir <- "C:/Users/szapa/Documents/Maestria_IPN/Cuarto_semestre/Estancia/INIA/texel/servidor/comparaciones"
setwd(basedir)
# Archivos y nombres
archivos <- c(
"ebv_gebv_rasgo1.xlsx",
"ebv_gebv_rasgo2.xlsx",
"ebv_gebv_rasgo3.xlsx",
"ebv_gebv_rasgo4.xlsx",
"ebv_gebv_rasgo5.xlsx",
"ebv_gebv_rasgo6.xlsx"
)
rasgos <- c(
"Peso al nacimiento",
"Peso al destete",
"Peso de recría",
"Área ojo de bife",
"Espesor de grasa",
"Peso de canal caliente"
)
# Leer y unir todos los datos
lista_df <- list()
for(i in 1:6){
df <- read_excel(archivos[i])
df$rasgo <- rasgos[i]
lista_df[[i]] <- df
}
datos <- bind_rows(lista_df)
# Gráfico multipanel
p <- ggplot(datos,
aes(x = acc_ebv,
y = acc_gebv,
color = genotipados)) +
geom_point(size = 2.5,
alpha = 0.9) +
geom_abline(slope = 1,
intercept = 0,
color = "red",
linewidth = 0.7) +
scale_color_manual(values = c(
"SI" = "#3C5488",
"NO" = "#00A087"
)) +
facet_wrap(~rasgo,
ncol = 2) +
theme_classic(base_size = 14) +
labs(
x = "EBV accuracy",
y = "GEBV accuracy",
color = "Genotipado"
) +
theme(
strip.text = element_text(face = "bold", size = 12),
legend.position = "bottom"
)
# Mostrar
p
# Exportar
ggsave(
"Figura_multipanel_accuracies.png",
p,
width = 12,
height = 15,
dpi = 600
)
